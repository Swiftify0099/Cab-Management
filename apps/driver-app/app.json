{
  "expo": {
    "name": "CabBooking Partner",
    "slug": "cabooking-driver",
    "scheme": "cabooking-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E1F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cabooking.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to show you nearby trip requests.",
        "NSLocationAlwaysUsageDescription": "Background location allows us to match you with passengers even when the app is in background.",
        "NSCameraUsageDescription": "Camera is needed to upload your KYC documents.",
        "NSPhotoLibraryUsageDescription": "Photo library is used to select KYC documents."
      }
    },
    "android": {
      "package": "com.cabooking.driver",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E1F"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_CONTACTS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],

      "useNextNotificationsApi": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCZw4DVNyJwP85ZeDG1y_x8DLQ7bF8J0EU"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to allow you to upload KYC documents and profile photos.",
          "cameraPermission": "The app accesses your camera to capture KYC document photos and live selfies."
        }
      ],
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CabBooking needs your location to track your trip and show customers your position in real-time.",
          "locationAlwaysPermission": "Background location lets us track your trip even when the app is in the background.",
          "locationWhenInUsePermission": "CabBooking needs your location to match you with nearby passengers."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F59E0B",
          "sounds": [
            "./assets/audio/siren.mp3",
            "./assets/audio/dr_siran.mp3"
          ]
        }
      ],
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "AIzaSyCZw4DVNyJwP85ZeDG1y_x8DLQ7bF8J0EU"
        }
      ],
      "./plugins/withDisabledPngCrunching"
    ],
    "extra": {
      "apiUrl": "https://cab-management-1.onrender.com/api/v1",
      "wsUrl": "https://cab-management-1.onrender.com",
      "router": {},
      "eas": {
        "projectId": "31319d2a-c1ac-4759-a2ab-0bce823e6bf2"
      }
    }
  }
}
