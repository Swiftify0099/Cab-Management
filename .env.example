# CabBooking SuperApp — Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=aws-0-ap-south-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.iyndjpsmahgugrcpkvip
POSTGRES_PASSWORD=fpqSlqh3DiQm68o0

# Full async DSN used by all services
# 1. Cloud Pooler / Host execution (Default):
DATABASE_URL=postgresql+asyncpg://postgres.iyndjpsmahgugrcpkvip:fpqSlqh3DiQm68o0@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# 2. Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://cabooking_user:cabooking_pass@localhost:5432/cabooking
# 3. Docker Compose Internal Network:
# DATABASE_URL=postgresql+asyncpg://cabooking_user:cabooking_pass@postgres:5432/cabooking

# ─── Redis ────────────────────────────────────────────────────
# 1. Cloud Upstash Redis (Default - accessible from local host scripts without docker):
REDIS_URL=rediss://default:gQAAAAAAApumAAIgcDJhYWMyMzA5NmNkOTI0MGYzOTYzNDY4YTJkMzU1YjBkMw@stunning-squid-170918.upstash.io:6379
# 2. Local Redis:
# REDIS_URL=redis://localhost:6379/0
# 3. Docker Compose Internal Network:
# REDIS_URL=redis://redis:6379/0

# ─── JWT / Auth ───────────────────────────────────────────────
JWT_SECRET_KEY=supersecretjwtkey_changeme_in_production_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Service Ports ────────────────────────────────────────────
AUTH_SERVICE_PORT=8001
BOOKING_SERVICE_PORT=8002
MATCHING_SERVICE_PORT=8003
PAYMENT_SERVICE_PORT=8004
PARCEL_SERVICE_PORT=8005
HOTEL_SERVICE_PORT=8006
NOTIFICATION_SERVICE_PORT=8007
ANALYTICS_SERVICE_PORT=8008
ADMIN_SERVICE_PORT=8009
WEBSOCKET_GATEWAY_PORT=8010

# ─── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=webhook_secret_placeholder

# ─── Firebase (FCM Push) ──────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON={}

# ─── OTP (use mock value 123456 for dev) ─────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MOCK_MODE=true

# ─── Environment ──────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOCAL_IP=172.31.144.1
